{
  "schemaVersion": 1,
  "id": "echoes_beneath",
  "version": "${version}",
  "name": "Echoes Beneath",
  "description": "The lens remembers shape and sound, but not light.",
  "license": "MIT",
  "icon": "assets/echoes_beneath/icon.png",
  "environment": "*",
  "accessWidener": "echoes_beneath.accesswidener",
  "entrypoints": {
    "main": [
      "dev.fimkov.echoesbeneath.EchoesBeneathFabric"
    ],
    "client": [
      "dev.fimkov.echoesbeneath.client.EchoesBeneathClient"
    ],
    "fabric-datagen": [
      "dev.fimkov.echoesbeneath.datagen.EchoDataGenerator"
    ]
  },
  "mixins": [
    "echoes_beneath.mixins.json",
    {
      "config": "echoes_beneath.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.16.0",
    "fabric-api": "*",
    "minecraft": "~1.21.1",
    "java": ">=21"
  }
}
